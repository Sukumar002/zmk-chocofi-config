#include <behaviors.dtsi>

/* Layout-shift support is provided by this repository's local Zephyr module. */
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/layout_shift.h>
#include <layout_shift_kp_override.dtsi>

#include "zmk-helpers/helper.h"
#include "keys/36.h"
#include "studio_runtime_layers.dtsi"

/* Hana-aligned timing for every Mod-Tap key. */
&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    runtime-editable;
    runtime-default-active;
    display-name = "Mod-Tap";
};

/* Expose Chocofi layer-tap behavior to ZMK Studio as Hana does. */
&lt {
    runtime-editable;
    runtime-default-active;
    display-name = "Layer-Tap";
};

/* Keep the Chocofi's 36-key / five-column physical layout unchanged. */
#define BASE  0
#define NUM   1
#define NAV   2
#define SET   3
#define MOUSE 4

#define ___ &trans
#define _x_ &none
#define _CUT_   &kp LG(X)
#define _COPY_  &kp LG(C)
#define _PASTE_ &kp LG(V)

ZMK_MOD_MORPH(smart_shift,
    bindings = <&sk LSHFT>, <&caps_word>;
    mods = <(MOD_LSFT)>;
)

/ {
    chosen {
        /* Use the shield's explicit matrix transform; do not fall back to row*columns. */
        zmk,matrix-transform = &default_transform;
    };
};

/* GUI <-> Alt mapping: inactive = macOS, active = Windows. */
&tog_ls {
    layout-maps = <&layout_shift_map_gui_alt>;
};

/ {
    layout_shift_map_gui_alt: layout_shift_map_gui_alt {
        compatible = "zmk,layout-shift-map";
        mappings = <
            LGUI LALT LAYOUT_SHIFT_OPTIONAL_ALL
            LALT LGUI LAYOUT_SHIFT_OPTIONAL_ALL
            RGUI RALT LAYOUT_SHIFT_OPTIONAL_ALL
            RALT RGUI LAYOUT_SHIFT_OPTIONAL_ALL
        >;
    };

    macros {
        bt_select_profile: bt_select_profile {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2>, <&bt BT_SEL MACRO_PLACEHOLDER>;
        };

        bt_clear_profile: bt_clear_profile {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <20>;
            bindings =
                <&macro_param_1to2>,
                <&bt BT_SEL MACRO_PLACEHOLDER>,
                <&bt BT_CLR>;
        };
    };

    behaviors {
        bt_profile: bt_profile {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <3000>;
            bindings = <&bt_clear_profile>, <&bt_select_profile>;
            hold-trigger-key-positions = <0xffffffff 0xffffffff>;
            display-name = "Bluetooth Profile";
            runtime-editable;
            runtime-default-active;
        };

        SBD: S_BSPC_DEL {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        iu_backspace_combo {
            timeout-ms = <50>;
            bindings = <&kp COLON>;
            key-positions = <16 17>;
            layers = <BASE>;
        };

        jk_colon_combo {
            timeout-ms = <50>;
            bindings = <&smart_shift>;
            key-positions = <12 13>;
            layers = <BASE>;
        };

        /* Hana-style Studio unlock chord: first two physical positions on BASE. */
        studio_unlock_combo {
            timeout-ms = <50>;
            require-prior-idle-ms = <500>;
            layers = <BASE>;
            key-positions = <0 1>;
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
                &lt SET Q    &kp W       &kp E       &kp R       &kp T          &kp Y       &kp U       &kp I       &kp O       &kp P
                &mt LSHIFT A &mt LCTRL S &mt LALT D  &mt LGUI F  &lt NAV G      &kp H       &mt RGUI J  &mt RALT K  &mt RCTRL L &mt RSHIFT SEMI
                &kp Z        &kp X       &kp C       &kp V       &kp B          &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH
                                      &kp LSHIFT   &lt MOUSE TAB  &mt LGUI SPACE     &mt LALT RETURN  &lt NUM ESC  &SBD
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
                &kp F1  &kp F2  &kp F3  &kp F4  &kp F5       &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                &kp N1  &kp N2  &kp N3  &kp N4  &kp N5       &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
                &kp F11 &kp F12 &kp BSLH &kp LBKT &kp RBKT   &kp EQUAL &kp MINUS &kp LPAR &kp RPAR &kp APOS
                                      ___       ___       ___       ___       ___       ___
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
                ___   ___   ___   ___   ___       &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV &kp C_NEXT
                &kp CAPS ___   ___   ___   ___     &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT   ___
                ___   _CUT_ _COPY_ _PASTE_ ___     ___          ___          ___          ___         ___
                                      ___   ___   ___          ___          ___          ___
            >;
        };

        set_layer {
            display-name = "SET";
            bindings = <
                _x_ &bt_profile 0 0 &bt_profile 1 1 &bt_profile 2 2 &bt_profile 3 3
                    &bt_profile 4 4 &bootloader &out OUT_TOG &bt BT_CLR_ALL &tog_ls
                _x_ _x_ _x_ _x_ _x_ _x_ _x_ _x_ _x_ _x_
                _x_ _x_ _x_ _x_ _x_ _x_ _x_ _x_ _x_ _x_
                                      ___ ___ ___ ___ ___ ___
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
                ___ ___ ___ ___ ___       &msc SCRL_LEFT &msc SCRL_UP &mmv MOVE_UP &msc SCRL_DOWN &msc SCRL_RIGHT
                &mkp LCLK &mkp MCLK &mkp RCLK ___ ___  ___ &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT ___
                ___ ___ ___ ___ ___       ___ ___ ___ ___ ___
                                      ___ ___ ___ ___ ___ ___
            >;
        };

        /* Four compile-time slots reserved for layers added later in Studio. */
        ZMK_STUDIO_RUNTIME_LAYER_SLOTS_4
    };
};

/* vim:ft=cpp */
