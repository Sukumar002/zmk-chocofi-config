# SPDX-License-Identifier: MIT

if SHIELD_CHOCOFI_LEFT
config ZMK_KEYBOARD_NAME
    default "Chocofi"

config ZMK_SPLIT_ROLE_CENTRAL
    default y
endif

if SHIELD_CHOCOFI_CENTRAL_DONGLE
config ZMK_KEYBOARD_NAME
    default "Chocofi Dongle"
config ZMK_SPLIT_ROLE_CENTRAL
    default y
endif

if SHIELD_CHOCOFI_PERIPHERAL_LEFT
config ZMK_KEYBOARD_NAME
    default "Chocofi Left"
config ZMK_SPLIT_ROLE_CENTRAL
    default n
endif

if SHIELD_CHOCOFI_PERIPHERAL_RIGHT
config ZMK_KEYBOARD_NAME
    default "Chocofi Right"
config ZMK_SPLIT_ROLE_CENTRAL
    default n
endif

if SHIELD_CHOCOFI_LEFT || SHIELD_CHOCOFI_RIGHT || SHIELD_CHOCOFI_CENTRAL_DONGLE || SHIELD_CHOCOFI_PERIPHERAL_LEFT || SHIELD_CHOCOFI_PERIPHERAL_RIGHT

config ZMK_SPLIT
    default y

if ZMK_DISPLAY
config I2C
    default y
config SSD1306
    default y
endif

if LVGL
config LV_Z_VDB_SIZE
    default 64
config LV_DPI_DEF
    default 148
config LV_Z_BITS_PER_PIXEL
    default 1
choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice
endif

endif
