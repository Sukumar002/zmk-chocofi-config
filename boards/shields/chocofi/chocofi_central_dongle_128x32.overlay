#include "chocofi_central_dongle.overlay"

/ {
    chosen {
        zephyr,display = &oled;
    };
};

/* Match the known-working Hana Pro Micro / nice!nano SSD1306 setup. */
&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;

        width = <128>;
        height = <32>;

        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;

        multiplex-ratio = <31>;

        segment-remap;
        com-invdir;

        prechargep = <0x22>;
    };
};
