if SHIELD_CHOCOFI_CENTRAL_DONGLE || SHIELD_CHOCOFI_CENTRAL_DONGLE_128X64 || SHIELD_CHOCOFI_CENTRAL_DONGLE_128X32 || SHIELD_CHOCOFI_CENTRAL_LEFT
config ZMK_SPLIT_ROLE_CENTRAL
    default y
endif

if SHIELD_CHOCOFI_CENTRAL_DONGLE || SHIELD_CHOCOFI_CENTRAL_DONGLE_128X64 || SHIELD_CHOCOFI_CENTRAL_DONGLE_128X32
config ZMK_KEYBOARD_NAME
    default "Chocofi Dongle"
endif

if SHIELD_CHOCOFI_CENTRAL_LEFT
config ZMK_KEYBOARD_NAME
    default "Chocofi"
endif

if SHIELD_CHOCOFI_PERIPHERAL_LEFT
config ZMK_KEYBOARD_NAME
    default "Chocofi Left"
config ZMK_SPLIT_ROLE_CENTRAL
    default n
endif

if SHIELD_CHOCOFI_PERIPHERAL_RIGHT
config ZMK_KEYBOARD_NAME
    default "Chocofi Right"
config ZMK_SPLIT_ROLE_CENTRAL
    default n
endif

if SHIELD_CHOCOFI_LEFT || SHIELD_CHOCOFI_RIGHT || SHIELD_CHOCOFI_CENTRAL_DONGLE || SHIELD_CHOCOFI_CENTRAL_DONGLE_128X64 || SHIELD_CHOCOFI_CENTRAL_DONGLE_128X32 || SHIELD_CHOCOFI_CENTRAL_LEFT || SHIELD_CHOCOFI_PERIPHERAL_LEFT || SHIELD_CHOCOFI_PERIPHERAL_RIGHT
config ZMK_SPLIT
    default y

config SPI
    default y

config I2C
    default y

if ZMK_DISPLAY
config SSD1306
    default y

choice LV_FONT_DEFAULT
    default LV_FONT_DEFAULT_MONTSERRAT_12
endchoice

choice ZMK_LV_FONT_DEFAULT_SMALL
    default ZMK_LV_FONT_DEFAULT_SMALL_MONTSERRAT_12
endchoice

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice
endif # ZMK_DISPLAY
endif
